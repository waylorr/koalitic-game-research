{
  "version": "0.7",
  "language": "en",
  "phase": "workflow_definition",
  "principle": "THE WORLD IS THE GAME. THE SYSTEM is an authoring application over real footage, not a simulated 3D game.",
  "status_meaning": {
    "approved": "Current product decision; reconsider only with a clear reason.",
    "draft": "Working decision to validate in the next block review.",
    "pending": "Intent recorded; detailed behavior is not yet specified."
  },
  "screens": {
    "main_menu": {
      "title": "MAIN MENU",
      "status": "approved",
      "visual_status": "html_template",
      "visual_note": "Code-native menu with EPISODES, CONFIGURE HUD and ASSETS. Final cinematic imagery will be designed later.",
      "controls": [
        {
          "id": "episodes",
          "component": "PrimaryButton",
          "label": "EPISODES",
          "interaction": "click",
          "action_type": "navigate",
          "target": "episodes",
          "status": "approved"
        },
        {
          "id": "configure_hud",
          "component": "SecondaryButton",
          "label": "CONFIGURE HUD",
          "interaction": "click",
          "action_type": "navigate",
          "target": "configure_hud",
          "status": "approved"
        },
        {
          "id": "assets",
          "component": "SecondaryButton",
          "label": "ASSETS",
          "interaction": "click",
          "action_type": "navigate",
          "target": "assets",
          "status": "approved"
        },
        {
          "id": "quit_game",
          "component": "TextButton",
          "label": "QUIT GAME",
          "interaction": "click",
          "action_type": "command",
          "command": "QUIT_APP",
          "status": "draft"
        }
      ]
    },
    "new_episode": {
      "title": "NEW EPISODE",
      "status": "draft",
      "visual_status": "html_template",
      "visual_note": "Choose a name and video/image; an existing HUD template is optional because the default is preselected.",
      "controls": [
        {
          "id": "episode_name",
          "component": "TextInput",
          "label": "EPISODE NAME",
          "interaction": "input",
          "action_type": "input",
          "writes": [
            "draft_episode.name"
          ],
          "validation": "nonempty_trimmed",
          "status": "approved"
        },
        {
          "id": "media",
          "component": "MediaDropzone",
          "label": "VIDEO / IMAGE",
          "interaction": "select_file",
          "action_type": "input",
          "writes": [
            "draft_episode.media"
          ],
          "validation": "video_or_image",
          "status": "approved"
        },
        {
          "id": "hud_preset",
          "component": "PresetSelector",
          "label": "HUD TEMPLATE (OPTIONAL)",
          "interaction": "select",
          "action_type": "select",
          "reads": [
            "saved_hud_templates"
          ],
          "writes": [
            "draft_episode.hud_template_id"
          ],
          "status": "approved"
        },
        {
          "id": "cancel",
          "component": "SecondaryButton",
          "label": "CANCEL",
          "interaction": "click",
          "action_type": "navigate",
          "target": "episodes",
          "status": "approved"
        },
        {
          "id": "create_episode",
          "component": "PrimaryButton",
          "label": "CREATE EPISODE",
          "interaction": "click",
          "action_type": "command_then_navigate",
          "command": "CREATE_EPISODE",
          "target": "episode_editor",
          "reads": [
            "draft_episode.name",
            "draft_episode.media",
            "draft_episode.hud_template_id"
          ],
          "enabled_when": [
            "episode_name_valid",
            "media_selected"
          ],
          "persistence": "create episode with selected or default template snapshot and media reference",
          "status": "draft"
        }
      ]
    },
    "episodes": {
      "title": "EPISODES",
      "status": "approved",
      "visual_status": "html_template",
      "visual_note": "Code-native episode cards plus NEW EPISODE on one screen; no internal Load/New tabs.",
      "controls": [
        {
          "id": "girona",
          "component": "EpisodeCard",
          "label": "GIRONA",
          "interaction": "click",
          "action_type": "command_then_navigate",
          "command": "OPEN_EPISODE",
          "payload": {
            "episode_id": "girona_example"
          },
          "target": "episode_editor",
          "status": "approved"
        },
        {
          "id": "new_episode",
          "component": "EpisodeCard",
          "label": "NEW EPISODE",
          "interaction": "click",
          "action_type": "navigate",
          "target": "new_episode",
          "status": "approved"
        },
        {
          "id": "back",
          "component": "BackButton",
          "label": "BACK",
          "interaction": "click",
          "action_type": "navigate",
          "target": "main_menu",
          "status": "approved"
        }
      ]
    },
    "configure_hud": {
      "title": "CONFIGURE HUD",
      "status": "draft",
      "visual_status": "html_wireframe",
      "visual_note": "Template context of the shared HUD workspace. Fixed zones, module order, variants, motion and preview states; no episode data.",
      "controls": [
        {
          "id": "back",
          "component": "BackButton",
          "label": "BACK",
          "interaction": "click",
          "action_type": "navigate",
          "target": "main_menu",
          "status": "approved"
        },
        {
          "id": "preset",
          "component": "PresetSelector",
          "label": "HUD PRESET",
          "interaction": "select",
          "action_type": "select",
          "reads": [
            "saved_hud_presets"
          ],
          "writes": [
            "selected_hud_preset_id"
          ],
          "status": "draft"
        },
        {
          "id": "new_preset",
          "component": "SecondaryButton",
          "label": "NEW",
          "interaction": "click",
          "action_type": "command",
          "command": "CREATE_BASE_HUD_PRESET",
          "status": "draft"
        },
        {
          "id": "duplicate",
          "component": "SecondaryButton",
          "label": "DUPLICATE",
          "interaction": "click",
          "action_type": "command",
          "command": "DUPLICATE_HUD_PRESET",
          "status": "draft"
        },
        {
          "id": "save",
          "component": "PrimaryButton",
          "label": "SAVE",
          "interaction": "click",
          "action_type": "command",
          "command": "SAVE_HUD_PRESET",
          "persistence": "update selected preset",
          "status": "draft"
        },
        {
          "id": "module_select",
          "component": "HUDModuleRow",
          "label": "SELECT MODULE",
          "interaction": "click",
          "action_type": "set_state",
          "writes": [
            "selected_module_id"
          ],
          "status": "draft"
        },
        {
          "id": "module_enabled",
          "component": "Toggle",
          "label": "ENABLED",
          "interaction": "click",
          "action_type": "set_state",
          "writes": [
            "working_preset.modules[selected_module_id].enabled"
          ],
          "status": "draft"
        },
        {
          "id": "variant",
          "component": "Select",
          "label": "VISUAL VARIANT",
          "interaction": "select",
          "action_type": "select",
          "writes": [
            "working_preset.modules[selected_module_id].variant_id"
          ],
          "status": "draft"
        },
        {
          "id": "motion",
          "component": "Select",
          "label": "MOTION PRESET",
          "interaction": "select",
          "action_type": "select",
          "writes": [
            "working_preset.modules[selected_module_id].motion_id"
          ],
          "status": "draft"
        },
        {
          "id": "rail_motion",
          "component": "Select",
          "label": "LEFT RAIL TRANSITION",
          "interaction": "select",
          "action_type": "select",
          "writes": [
            "working_preset.zoneMotion.LEFT_RAIL"
          ],
          "status": "draft"
        },
        {
          "id": "preview_state",
          "component": "StateSelector",
          "label": "PREVIEW STATE",
          "interaction": "select",
          "action_type": "set_state",
          "writes": [
            "preview_only.module_state"
          ],
          "persistence": "none",
          "status": "draft"
        }
      ]
    },
    "assets": {
      "title": "ASSETS",
      "status": "draft",
      "visual_status": "html_template",
      "visual_note": "Media files, reusable Data Library records and a read-only UI component catalog. Template appearance lives in CONFIGURE HUD; episode data and time live in the Episode Editor.",
      "controls": [
        {
          "id": "back",
          "component": "BackButton",
          "label": "BACK",
          "interaction": "click",
          "action_type": "navigate",
          "target": "main_menu",
          "status": "approved"
        },
        {
          "id": "library_tab",
