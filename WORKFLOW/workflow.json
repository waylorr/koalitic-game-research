    "episode_editor": {
      "title": "EPISODE EDITOR",
      "status": "draft",
      "visual_status": "html_wireframe",
      "visual_note": "Episode context of the shared HUD workspace: media, Data Library bindings, HUD choice, time tracks and manual POV overlays. Browser-local save prototype.",
      "controls": [
        {
          "id": "playhead",
          "component": "TimelineScrubber",
          "label": "PLAYHEAD",
          "interaction": "input",
          "action_type": "input",
          "writes": [
            "episode.preview_time"
          ],
          "status": "draft"
        },
        {
          "id": "timeline_expand",
          "component": "TimelineTree",
          "label": "EXPAND ZONE / COMPONENT",
          "interaction": "click",
          "action_type": "set_state",
          "writes": [
            "timeline.expanded_nodes"
          ],
          "status": "draft"
        },
        {
          "id": "timeline_keyframe",
          "component": "KeyframeControl",
          "label": "ADD / JUMP / DELETE KEYFRAME",
          "interaction": "click",
          "action_type": "command",
          "command": "EDIT_PROPERTY_KEYFRAME",
          "status": "draft"
        },
        {
          "id": "timeline_property",
          "component": "PropertyControl",
          "label": "EDIT PROPERTY AT PLAYHEAD",
