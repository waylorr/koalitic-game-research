  },
  "scenarios": [
    {
      "id": "create_first_episode",
      "status": "draft",
      "steps": [
        "main_menu.episodes",
        "episodes.new_episode",
        "new_episode.episode_name",
        "new_episode.media",
        "new_episode.hud_preset",
        "new_episode.create_episode"
      ],
      "expected_screen": "episode_editor"
    },
    {
      "id": "open_existing_girona",
      "status": "approved",
      "steps": [
        "main_menu.episodes",
        "episodes.girona"
      ],
      "expected_screen": "episode_editor"
    },
    {
      "id": "switch_episode_hud",
